{
  "name": "yegna-ai-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Yegna AI - Ethiopia's AI Training Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm run dev --workspace=@yegna/web",
    "dev:api": "npm run dev --workspace=@yegna/api",
    "build": "turbo run build",
    "build:web": "npm run build --workspace=@yegna/web",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md}\"",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "prettier": "^3.2.0",
    "turbo": "^1.13.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  }
}